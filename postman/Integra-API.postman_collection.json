{
  "info": {
    "name": "Integra BC API",
    "description": "Testim i Integra Sales Orders API (Business Central Cloud Sandbox).\n\nPara perdorimit vendos vlerat te Variables:\n- clientId / clientSecret: nga App Registration ne Microsoft Entra\n- tenantId dhe environment jane te paravendosura\n\nRradha e testimit: 1 -> 2 -> 3 -> 4. Token-i merret automatikisht.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [{ "key": "token", "value": "{{accessToken}}", "type": "string" }]
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "const expiry = pm.collectionVariables.get('tokenExpiry');",
          "if (!pm.collectionVariables.get('accessToken') || !expiry || Date.now() > Number(expiry)) {",
          "    pm.sendRequest({",
          "        url: 'https://login.microsoftonline.com/' + pm.collectionVariables.get('tenantId') + '/oauth2/v2.0/token',",
          "        method: 'POST',",
          "        header: { 'Content-Type': 'application/x-www-form-urlencoded' },",
          "        body: {",
          "            mode: 'urlencoded',",
          "            urlencoded: [",
          "                { key: 'grant_type', value: 'client_credentials' },",
          "                { key: 'client_id', value: pm.collectionVariables.get('clientId') },",
          "                { key: 'client_secret', value: pm.collectionVariables.get('clientSecret') },",
          "                { key: 'scope', value: 'https://api.businesscentral.dynamics.com/.default' }",
          "            ]",
          "        }",
          "    }, (err, res) => {",
          "        if (err) { console.error('Token error:', err); return; }",
          "        const json = res.json();",
          "        if (json.access_token) {",
          "            pm.collectionVariables.set('accessToken', json.access_token);",
          "            pm.collectionVariables.set('tokenExpiry', Date.now() + (json.expires_in - 60) * 1000);",
          "        } else {",
          "            console.error('Token response:', JSON.stringify(json));",
          "        }",
          "    });",
          "}"
        ]
      }
    }
  ],
  "variable": [
    { "key": "tenantId", "value": "55859367-4aad-4e73-8ba9-d1d0be00d1bb" },
    { "key": "environment", "value": "Sandbox" },
    { "key": "baseUrl", "value": "https://api.businesscentral.dynamics.com/v2.0/{{tenantId}}/{{environment}}" },
    { "key": "clientId", "value": "" },
    { "key": "clientSecret", "value": "" },
    { "key": "companyId", "value": "" },
    { "key": "orderId", "value": "" },
    { "key": "accessToken", "value": "" },
    { "key": "tokenExpiry", "value": "" }
  ],
  "item": [
    {
      "name": "1. Get Companies",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const json = pm.response.json();",
              "if (json.value && json.value.length > 0) {",
              "    pm.collectionVariables.set('companyId', json.value[0].id);",
              "    console.log('companyId u vendos automatikisht:', json.value[0].id, '(' + json.value[0].name + ')');",
              "}"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "url": {
          "raw": "{{baseUrl}}/api/v2.0/companies",
          "host": ["{{baseUrl}}"],
          "path": ["api", "v2.0", "companies"]
        },
        "description": "Merr listen e kompanive dhe vendos automatikisht companyId (te paren). Nese do nje kompani tjeter, kopjoje id-ne e saj te Variables > companyId."
      }
    },
    {
      "name": "2. Create Sales Order (deep insert)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "if (pm.response.code === 201) {",
              "    const json = pm.response.json();",
              "    pm.collectionVariables.set('orderId', json.id);",
              "    console.log('orderId u ruajt:', json.id, '| entryNo:', json.entryNo, '| status:', json.status);",
              "}"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n    \"customerNo\": \"CUC-000030\",\n    \"customerName\": \"Longevity Peptides\",\n    \"address\": \"13402 SW 122nd Ave\",\n    \"city\": \"Tigard\",\n    \"countryRegionCode\": \"US\",\n    \"phoneNo\": \"+15033204120\",\n    \"email\": \"longevitypeptides@gmail.com\",\n    \"orderDate\": \"2026-08-04\",\n    \"postingDate\": \"2026-08-05\",\n    \"documentDate\": \"2026-08-05\",\n    \"externalDocumentNo\": \"2883\",\n    \"salespersonCode\": \"AG006\",\n    \"lines\": [\n        { \"itemNo\": \"DP00022\", \"locationCode\": \"200-MAINWA\", \"quantity\": 2, \"unitOfMeasureCode\": \"BOX\", \"unitPrice\": 105.00, \"lineDiscountPercent\": 11 },\n        { \"itemNo\": \"DP00005\", \"locationCode\": \"200-MAINWA\", \"quantity\": 2, \"unitOfMeasureCode\": \"BOX\", \"unitPrice\": 85.00, \"lineDiscountPercent\": 11 },\n        { \"itemNo\": \"DP00004\", \"locationCode\": \"200-MAINWA\", \"quantity\": 3, \"unitOfMeasureCode\": \"BOX\", \"unitPrice\": 260.00, \"lineDiscountPercent\": 11 },\n        { \"itemNo\": \"DP00014\", \"locationCode\": \"200-MAINWA\", \"quantity\": 3, \"unitOfMeasureCode\": \"BOX\", \"unitPrice\": 255.00, \"lineDiscountPercent\": 11 },\n        { \"itemNo\": \"DP00032\", \"locationCode\": \"200-MAINWA\", \"quantity\": 6, \"unitOfMeasureCode\": \"BOX\", \"unitPrice\": 90.00, \"lineDiscountPercent\": 11 },\n        { \"itemNo\": \"DP00009\", \"locationCode\": \"200-MAINWA\", \"quantity\": 2, \"unitOfMeasureCode\": \"BOX\", \"unitPrice\": 180.00, \"lineDiscountPercent\": 11 },\n        { \"itemNo\": \"DP00008\", \"locationCode\": \"200-MAINWA\", \"quantity\": 4, \"unitOfMeasureCode\": \"BOX\", \"unitPrice\": 135.00, \"lineDiscountPercent\": 11 },\n        { \"itemNo\": \"DP00010\", \"locationCode\": \"200-MAINWA\", \"quantity\": 3, \"unitOfMeasureCode\": \"BOX\", \"unitPrice\": 290.00, \"lineDiscountPercent\": 11 },\n        { \"itemNo\": \"DP00028\", \"locationCode\": \"200-MAINWA\", \"quantity\": 5, \"unitOfMeasureCode\": \"BOX\", \"unitPrice\": 50.00, \"lineDiscountPercent\": 11 },\n        { \"itemNo\": \"DP00024\", \"locationCode\": \"200-MAINWA\", \"quantity\": 1, \"unitOfMeasureCode\": \"BOX\", \"unitPrice\": 140.00, \"lineDiscountPercent\": 11 }\n    ]\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/integra/integration/v1.0/companies({{companyId}})/salesOrders",
          "host": ["{{baseUrl}}"],
          "path": ["api", "integra", "integration", "v1.0", "companies({{companyId}})", "salesOrders"]
        },
        "description": "Krijon nje porosi ne Integra Sales Order Inbox me header + rreshta ne nje kerkese. Pergjigja 201 Created; id ruhet automatikisht te orderId."
      }
    },
    {
      "name": "3. Process Sales Order",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": { "mode": "raw", "raw": "{}" },
        "url": {
          "raw": "{{baseUrl}}/api/integra/integration/v1.0/companies({{companyId}})/salesOrders({{orderId}})/Microsoft.NAV.process",
          "host": ["{{baseUrl}}"],
          "path": ["api", "integra", "integration", "v1.0", "companies({{companyId}})", "salesOrders({{orderId}})", "Microsoft.NAV.process"]
        },
        "description": "Therret aksionin 'process' qe e kthen porosine nga inbox ne Sales Order real ne BC."
      }
    },
    {
      "name": "4. Get Sales Orders (kontrollo statusin)",
      "request": {
        "method": "GET",
        "url": {
          "raw": "{{baseUrl}}/api/integra/integration/v1.0/companies({{companyId}})/salesOrders?$expand=lines&$orderby=entryNo desc&$top=5",
          "host": ["{{baseUrl}}"],
          "path": ["api", "integra", "integration", "v1.0", "companies({{companyId}})", "salesOrders"],
          "query": [
            { "key": "$expand", "value": "lines" },
            { "key": "$orderby", "value": "entryNo desc" },
            { "key": "$top", "value": "5" }
          ]
        },
        "description": "Liston 5 porosite e fundit me rreshtat, statusin, errorMessage dhe createdSalesOrderNo."
      }
    }
  ]
}
